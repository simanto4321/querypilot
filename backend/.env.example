# Copy to .env and adjust. All variables are prefixed with QUERYPILOT_.

# Analytics warehouse. Defaults to zero-setup SQLite.
# PostgreSQL (docker-compose path):
#   QUERYPILOT_WAREHOUSE_URL=postgresql+psycopg://analytics:analytics@localhost:5432/analytics
QUERYPILOT_WAREHOUSE_URL=sqlite:///./querypilot.db

# NL->SQL provider: "deterministic" (offline, default) or "openai".
QUERYPILOT_LLM_PROVIDER=deterministic
# QUERYPILOT_OPENAI_API_KEY=sk-...
# QUERYPILOT_OPENAI_MODEL=gpt-4o-mini

# Guardrails
QUERYPILOT_MAX_ROWS=1000
QUERYPILOT_APPROVAL_ROW_THRESHOLD=50000

QUERYPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
